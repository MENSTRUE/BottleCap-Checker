.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# Secrets / local configuration (retain public template)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*credentials*.json

# JavaScript / Vite / TypeScript
node_modules/
dist/
coverage/
*.tsbuildinfo
.vite/

# Notebook and local experimentation caches
.ipynb_checkpoints/
.kaggle/
wandb/
mlruns/
lightning_logs/

