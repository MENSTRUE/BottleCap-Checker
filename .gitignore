/data/
/datasets/
/uploads/
/outputs/
/runs/
/tmp/
/temp/
*.zip
*.7z
*.rar
*.tar.gz

# Local platform and editor noise
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Backups, swaps and temporary logs
*.bak
*.swp
*.swo
*.tmp
*.log

# IMPORTANT: Do not globally ignore *.pt / *.onnx / *.ipynb, models/, reports/, or assets/plots/.
# These exact research artifacts are intentionally versioned in this repository.
